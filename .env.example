# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Project Database URL and Anon Public Key for PostgreSQL / Supabase
SUPABASE_URL="https://mzdnmqkgebbfqgdgulln.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"
VITE_SUPABASE_URL="https://mzdnmqkgebbfqgdgulln.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# PORTAL ROLE ISOLATION & SECRET ADMIN PATH:
# Options for VITE_PORTAL_MODE: "user" (strict User Portal only), "admin" (strict Admin Portal only), or leave empty
VITE_PORTAL_MODE=""
# Custom unguessable URL slug for accessing Admin Login & Console (e.g. https://domain.com/kunci-admin-9x7k4m2p)
VITE_ADMIN_SECRET_PATH="kunci-admin-9x7k4m2p"

